                android:repeatMode="reverse"
                android:valueFrom="M-51.9 -16.3 L-56.4 31.1 L-93.2 23.6 L-90.4 -4.9 Z"
                android:valueTo="M-53.1 -1.9 L-51.3 45.7 L-87.2 49.8 L-88.3 21.2 Z"

                android:translateY="216">
                <group android:name="spin">
                    <group
                        android:name="sizing"
                        android:scaleX="0.36"
                        android:scaleY="0.36">
                        <group
                            android:name="place"
                            android:translateX="-54.4"
                            android:translateY="-0.0">
                            <group android:name="fish">

                                <path
                                    android:name="head"
                                    android:fillAlpha="0.63"
                                    android:fillColor="#F45C47"
                                    android:pathData="M20.4 0.0 a34.0 34.0 0 1 0 68.0 0 a34.0 34.0 0 1 0 -68.0 0 Z" />

                                <path
                                    android:name="bead1"
                                    android:fillAlpha="0.63"
                                    android:fillColor="#F45C47"
                                    android:pathData="M-77.9 7.4 a23.8 23.8 0 1 0 47.6 0 a23.8 23.8 0 1 0 -47.6 0 Z" />

                                <path
                                    android:name="fin0"
                                    android:fillAlpha="0.39"
                                    android:fillColor="#F45C47"
                                    android:pathData="M44.2 -28.9 Q-8.3 -89.6 0.1 -20.0 Z" />
                                <path
                                    android:name="fin1"
                                    android:fillAlpha="0.39"
                                    android:fillColor="#F45C47"
                                    android:pathData="M43.6 28.6 Q4.6 97.4 0.8 21.8 Z" />

                                <group android:name="tail" android:pivotX="-54.1" android:pivotY="7.4">
                                    <path
                                        android:name="quad1"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-51.9 -16.3 L-56.4 31.1 L-93.2 23.6 L-90.4 -4.9 Z" />
                                    <path
                                        android:name="bead2"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-106.1 9.4 a14.3 14.3 0 1 0 28.6 0 a14.3 14.3 0 1 0 -28.6 0 Z" />
                                    <path
                                        android:name="quad2"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-92.8 -4.9 L-90.8 23.6 L-135.0 23.6 L-135.9 12.2 Z" />
                                    <path
                                        android:name="bead3"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-141.2 17.9 a5.7 5.7 0 1 0 11.4 0 a5.7 5.7 0 1 0 -11.4 0 Z" />
                                    <path
                                        android:name="tail_in"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-91.8 9.4 L-124.4 14.5 L-124.3 16.1 Z" />
                                    <path
                                        android:name="tail_out"
                                        android:fillAlpha="0.63"
                                        android:fillColor="#F45C47"
                                        android:pathData="M-91.8 9.4 L-136.5 -5.5 L-134.3 41.8 Z" />
                                </group>

                                <path
                                    android:name="body"
                                    android:fillAlpha="0.88"
                                    android:fillColor="#F45C47"
                                    android:pathData="M60.6 -33.4 Q14.3 -45.9 -55.8 -16.0 L-52.4 31.4 Q16.2 47.4 60.1 33.5 Z" />
                            </group>
                        </group>
                    </group>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="orbit">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/linear"
                android:pathData="M311,216 A95,95 0 1 1 121,216 A95,95 0 1 1 311,216"
                android:propertyName="translateXY"
                android:propertyXName="translateX"
                android:propertyYName="translateY"
                android:repeatCount="infinite" />
        </aapt:attr>
    </target>

    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1000"
                android:interpolator="@android:interpolator/linear"
                android:propertyName="rotation"
                android:repeatCount="infinite"
                android:valueFrom="82"
                android:valueTo="442"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="bead1">

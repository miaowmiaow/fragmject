                android:interpolator="@android:interpolator/accelerate_decelerate"
                android:propertyName="pathData"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:valueFrom="M-77.9 7.4 a23.8 23.8 0 1 0 47.6 0 a23.8 23.8 0 1 0 -47.6 0 Z"
                android:valueTo="M-76.0 21.9 a23.8 23.8 0 1 0 47.6 0 a23.8 23.8 0 1 0 -47.6 0 Z"
